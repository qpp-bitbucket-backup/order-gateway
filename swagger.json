{
  "openapi": "3.0.0",
  "info": {
    "title": "HP PrintOS Site Flow API",
    "description": "API for managing print orders, including validation, submission, and status tracking.",
    "version": "1.0.0",
    "contact": {
      "name": "HP Developer Portal",
      "url": "https://developers.hp.com/"
    }
  },
  "servers": [
    {
      "url": "https://printos.api.hp.com/siteflow",
      "description": "Production server (for existing PrintOS customers)"
    },
    {
      "url": "https://stage.printos.api.hp.com/siteflow",
      "description": "Staging server (for 3rd parties)"
    }
  ],
  "paths": {
    "/api/order/validate": {
      "post": {
        "summary": "Validate an Order",
        "description": "Submits an order for validation without actually creating it.",
        "operationId": "validateOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderValidationRequest"
              },
              "example": {
                "destination": {
                  "name": "accountName"
                },
                "orderData": {
                  "sourceOrderId": "1234512345",
                  "items": [
                    {
                      "sku": "Business Cards",
                      "components": [
                        {
                          "code": "Content",
                          "fetch": true,
                          "path": "http://www.w2psite.com/businessCard.pdf"
                        }
                      ]
                    }
                  ],
                  "shipments": [
                    {
                      "shipTo": {
                        "name": "John Doe",
                        "companyName": "Acme",
                        "address1": "1234 Main St.",
                        "town": "Capitol",
                        "postcode": "12345",
                        "isoCountry": "US"
                      },
                      "carrier": {
                        "code": "fedex",
                        "service": "ground"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderValidationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order": {
      "post": {
        "summary": "Submit an Order",
        "description": "Submits a new print order.\n\nThe order payload is uploaded to OSS as a JSON file and a pre-signed download URL is included in the response.\n\n**Duplicate detection:** If an order with the same `sourceOrderId` already exists for this store, the API returns HTTP **400** with a SiteFlow-compatible error response.",
        "operationId": "submitOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderSubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed — duplicate sourceOrderId detected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCreationErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "ofError": true,
                    "statusCode": 400,
                    "code": 208,
                    "message": "Validation Failed",
                    "validations": [
                      {
                        "path": "orderData.sourceOrderId",
                        "message": "Source Order ID already exists"
                      }
                    ],
                    "mongoErr": true
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request body validation failed (missing required fields, wrong types, etc.).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCreationErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "ofError": true,
                    "statusCode": 422,
                    "message": "Validation Failed",
                    "validations": [
                      {
                        "path": "orderData.sourceOrderId",
                        "message": "Field required"
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error during order submission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderCreationErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "ofError": true,
                    "statusCode": 500,
                    "message": "Order submission failed: internal error"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get All Orders",
        "description": "Retrieves a paginated list of orders.",
        "operationId": "getAllOrders",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "The page number to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "Number of orders per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/{orderId}": {
      "get": {
        "summary": "Get an Order",
        "description": "Retrieves detailed information for a specific order by its ID.",
        "operationId": "getOrderById",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "The unique identifier of the order.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/{orderId}": {
      "put": {
        "summary": "Update an Order",
        "description": "Updates the destination and/or order data of an existing order.\n\nThe order can **only** be updated when it is in a cancellable state (`received`, `pending`, `validated`, `failed`, `errored`). Orders with status `printready`, `printed`, `shipped`, or `cancelled` will return HTTP **409 Conflict**.",
        "operationId": "updateOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "description": "The internal order ID (returned as `_id` in the order response).",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderUpdateRequest"
              },
              "example": {
                "destination": {
                  "name": "newAccountName"
                },
                "orderData": {
                  "sourceOrderId": "1234512345",
                  "items": [
                    {
                      "sku": "Business Cards",
                      "quantity": 2,
                      "components": [
                        {
                          "code": "Content",
                          "fetch": true,
                          "path": "http://www.w2psite.com/businessCard_v2.pdf"
                        }
                      ]
                    }
                  ],
                  "shipments": [
                    {
                      "shipTo": {
                        "name": "Jane Smith",
                        "isoCountry": "US"
                      },
                      "carrier": {
                        "code": "fedex",
                        "service": "express"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderUpdateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Neither 'destination' nor 'orderData' was provided.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Order not found or access denied.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "Order cannot be updated because it is no longer in a cancellable state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "detail": "Cannot update order with status 'printready'. Order must be in one of: received, pending, validated, failed, errored."
                }
              }
            }
          }
        }
      }
    },
    "/api/order/{sourceAccount}/{sourceOrderId}/cancel": {
      "put": {
        "summary": "Cancel Order",
        "description": "Cancels an existing order using the source account and source order ID.",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "sourceAccount",
            "in": "path",
            "description": "The source.name of the account.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourceOrderId",
            "in": "path",
            "description": "The user-generated sourceOrderId.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelledOrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Order not found or access denied (wrong store).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteFlowErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "message": "Order with sourceOrderId 'ORD-001' not found or access denied",
                    "name": "NotFound",
                    "code": 404
                  }
                }
              }
            }
          },
          "409": {
            "description": "Order status does not allow cancellation (e.g. already printed, shipped, or cancelled).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteFlowErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "message": "Cannot cancel order with status 'printed'.",
                    "name": "Conflict",
                    "code": 409
                  }
                }
              }
            }
          },
          "502": {
            "description": "QPMN cancel API call failed. The order was not cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteFlowErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "message": "QPMN cancel API returned 500: Internal Server Error",
                    "name": "BadGateway",
                    "code": 502
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error during cancellation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteFlowErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "message": "Order cancellation failed: unexpected database error",
                    "name": "InternalServerError",
                    "code": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/file/resize": {
      "post": {
        "summary": "Resize PDF",
        "description": "Resizes all pages of an uploaded PDF to the specified dimensions.\n\n**Dimension formats:**\n- Points (plain number): `595`\n- Millimeters: `210mm`\n- Inches: `8.5in`\n- Named sizes: `a3`, `a4`, `a5`, `letter`, `legal`, `tabloid`\n\n**fit mode:**\n- `false` (default): Content is cropped or extended to the new size.\n- `true`: Content is scaled to fit within the new page while keeping the aspect ratio, centered.",
        "operationId": "resizePdf",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "width", "height"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The PDF file to resize."
                  },
                  "width": {
                    "type": "string",
                    "description": "Target page width, e.g. '210mm', '595pt', 'a4'.",
                    "example": "210mm"
                  },
                  "height": {
                    "type": "string",
                    "description": "Target page height, e.g. '297mm', '842pt', 'a4'.",
                    "example": "297mm"
                  },
                  "fit": {
                    "type": "boolean",
                    "description": "Scale content to fit the new page while keeping aspect ratio.",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resize metadata returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PDFResizeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/file/resize/download": {
      "post": {
        "summary": "Download Resized PDF",
        "description": "Re-processes and returns the resized PDF as a downloadable binary file (`application/pdf`). Accepts the same parameters as `/api/file/resize`.",
        "operationId": "downloadResizedPdf",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "width", "height"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The original PDF file."
                  },
                  "width": {
                    "type": "string",
                    "description": "Same width used in the resize request.",
                    "example": "210mm"
                  },
                  "height": {
                    "type": "string",
                    "description": "Same height used in the resize request.",
                    "example": "297mm"
                  },
                  "fit": {
                    "type": "boolean",
                    "description": "Same fit flag used in the resize request.",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resized PDF file returned as binary download.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "e.g. attachment; filename=\"myfile_resized.pdf\""
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/api/file/getpreupload": {
      "get": {
        "summary": "Get File Upload URLs",
        "description": "Retrieves pre-signed URLs for uploading a local file to cloud storage.",
        "operationId": "getFileUploadUrls",
        "parameters": [
          {
            "name": "MIME Type of file to upload (i.e. application/pdf)",
            "in": "query",
            "description": "The MIME type of the file to be uploaded.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/pdf"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URLs for upload and fetch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadUrlsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/product": {
      "get": {
        "summary": "Get Products",
        "description": "Retrieves a list of available products, including their components and attributes.",
        "operationId": "getProducts",
        "responses": {
          "200": {
            "description": "List of products",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sku": {
      "get": {
        "summary": "Get SKUs",
        "description": "Retrieves a list of available SKUs.",
        "operationId": "getSkus",
        "responses": {
          "200": {
            "description": "List of SKUs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkusListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderValidationRequest": {
        "type": "object",
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Destination"
          },
          "orderData": {
            "$ref": "#/components/schemas/OrderData"
          },
          "source": {
            "type": "object",
            "description": "Source information."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Associated files."
          }
        }
      },
      "OrderSubmissionRequest": {
        "type": "object",
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Destination"
          },
          "orderData": {
            "$ref": "#/components/schemas/OrderData"
          },
          "source": {
            "type": "object",
            "description": "Source information."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Associated files."
          }
        }
      },
      "OrderData": {
        "type": "object",
        "properties": {
          "sourceOrderId": {
            "type": "string"
          },
          "postbackAddress": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          },
          "shipments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Shipment"
            }
          },
          "stockItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockItem"
            },
            "description": "Stock items required for production."
          },
          "printType": {
            "type": "string",
            "description": "Print type (e.g., 'digital')."
          },
          "email": {
            "type": "string",
            "description": "Customer email."
          },
          "amount": {
            "type": "number",
            "description": "Order amount."
          },
          "customerName": {
            "type": "string",
            "description": "Customer name."
          },
          "extraData": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Extra order data."
          },
          "status": {
            "type": "string",
            "description": "Order status (read-only, returned in responses only). Mapping: received/pending→received, validated/processing→dataready, printready→printready, printed→printed, shipped→shipped, errored/failed→error, cancelled→cancelled.",
            "enum": ["received", "dataready", "printready", "printed", "shipped", "error", "cancelled"],
            "readOnly": true
          }
        }
      },
      "StockItem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stock item code."
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "description": "Stock quantity."
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "sourceItemId": {
            "oneOf": [
              {"type": "string"},
              {"type": "integer"}
            ],
            "description": "External item ID."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "printQuantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "minimum": 0
          },
          "unitCost": {
            "type": "number",
            "minimum": 0
          },
          "unitWeight": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "description": "Item description."
          },
          "productDescription": {
            "type": "string",
            "description": "Product description (alias for description)."
          },
          "pages": {
            "type": "integer",
            "description": "Number of pages."
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "shipmentIndex": {
            "type": "integer",
            "description": "Index linking this item to a shipment."
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Component"
            }
          },
          "extraData": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Extra item data."
          }
        }
      },
      "Component": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "fetch": {
            "type": "boolean",
            "default": true
          },
          "path": {
            "type": "string"
          },
          "localFile": {
            "type": "boolean",
            "description": "Whether the file is local."
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          },
          "paperId": {
            "type": "string"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true
          },
          "colour": {
            "$ref": "#/components/schemas/Color"
          },
          "finish": {
            "$ref": "#/components/schemas/Finish"
          },
          "extraData": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Extra component data."
          }
        }
      },
      "Color": {
        "type": "object",
        "properties": {
          "side1": {
            "type": "string",
            "description": "Front side color."
          },
          "side2": {
            "type": "string",
            "description": "Back side color."
          }
        }
      },
      "Finish": {
        "type": "object",
        "properties": {
          "side1": {
            "type": "string",
            "description": "Front side finish."
          },
          "side2": {
            "type": "string",
            "description": "Back side finish."
          }
        }
      },
      "Shipment": {
        "type": "object",
        "properties": {
          "shipTo": {
            "$ref": "#/components/schemas/Address"
          },
          "carrier": {
            "$ref": "#/components/schemas/Carrier"
          },
          "shipmentIndex": {
            "type": "integer",
            "description": "Index linking items to this shipment."
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Shipment attachments."
          },
          "pspBranding": {
            "type": "boolean",
            "description": "PSP branding flag."
          },
          "returnAddress": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Carrier": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Carrier code (e.g., fedex)."
          },
          "service": {
            "type": "string",
            "description": "Service level (e.g., ground)."
          },
          "serviceId": {
            "type": "string",
            "description": "Service identifier."
          },
          "alias": {
            "type": "string",
            "description": "Carrier alias (e.g., 'tracked')."
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Recipient name."
          },
          "companyName": {
            "type": "string",
            "description": "Company name."
          },
          "address1": {
            "type": "string",
            "description": "Street address line 1."
          },
          "address2": {
            "type": "string",
            "description": "Street address line 2."
          },
          "address3": {
            "type": "string",
