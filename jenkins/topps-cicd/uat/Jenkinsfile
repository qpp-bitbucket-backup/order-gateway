pipeline {
    agent {
        label 'docker'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        // This stops Jenkins from automatically checking out your code
        skipDefaultCheckout()
    }
    environment {
        ACR_REGISTRY   = 'prod-plugin-acr-registry.cn-guangzhou.cr.aliyuncs.com'
        ACR_VPC_REGISTRY = 'prod-plugin-acr-registry-vpc.cn-guangzhou.cr.aliyuncs.com'
        ACR_NAMESPACE  = 'uat'
        ACR_REPO       = 'order-gateway'
    }

    stages {
        stage('Checkout App Code & Get Version') {
            steps {
                dir('app') {
                    checkout scmGit(
                        branches: [[name: '*/develop']],
                        userRemoteConfigs: [[
                            url: 'https://itdev25@bitbucket.org/qpp-team/order-gateway.git',
                            credentialsId: 'bitbucket-ci-api-token'
                        ]]
                    )

                script {
                    def appVersion = sh(
                        script: '''
                            grep '^version =' pyproject.toml \
                            | head -1 \
                            | awk -F'= ' '{ print $2 }' \
                            | sed 's/["]//g'
                        ''',
                        returnStdout: true
                    ).trim()
                
                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()
                
                    env.IMAGE_TAG = "${appVersion}-${commitId}-dev"
                
                    echo "Detected Version : ${appVersion}"
                    echo "Commit ID        : ${commitId}"
                    echo "Image Tag        : ${env.IMAGE_TAG}"
                }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container('docker') {
                    script {
                        sh """
                            docker build \
                              -t ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:${IMAGE_TAG} \
                              -t ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:latest \
                              -f app/Dockerfile \
                              app
                        """
                    }
                }
            }
        }

        stage('Push to ACR') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'aliyun-acr-credential',
                        usernameVariable: 'ACR_USER',
                        passwordVariable: 'ACR_PASS'
                    )]) {
                        sh """
                            echo "\${ACR_PASS}" | docker login \
                                --username="\${ACR_USER}" \
                                --password-stdin \
                                ${ACR_REGISTRY}

                            docker push ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:${IMAGE_TAG}
                            docker push ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:latest

                            docker logout ${ACR_REGISTRY}
                        """
                        echo "Successfully pushed image: ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:${IMAGE_TAG}"
                    }
                }
            }
        }



    }
    post {
        success {
            echo "Pipeline completed successfully!"
            echo "Docker Image Tag: ${env.IMAGE_TAG}"
            echo "Image pushed to: ${ACR_REGISTRY}/${ACR_REPO}:${env.IMAGE_TAG}"

        }
        failure {
            echo "Pipeline failed!"
            echo "Please check the logs for error details"
        }
        always {
            echo "Cleaning workspace"
            cleanWs()
        }
    }
}