pipeline {
    agent {
        label 'docker'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        // This stops Jenkins from automatically checking out your code
        skipDefaultCheckout()
    }
    environment {
        ACR_REGISTRY   = 'prod-plugin-acr-registry.cn-guangzhou.cr.aliyuncs.com'
        ACR_VPC_REGISTRY = 'prod-plugin-acr-registry-vpc.cn-guangzhou.cr.aliyuncs.com'
        ACR_NAMESPACE  = 'uat'
        ACR_REPO       = 'order-gateway'

        DEPLOYMENT_FILE1 = 'topps/order-gateway/uat/deployment.yml'

        DEPLOYMENT_FILE2 = 'topps/order-gateway-worker/uat/deployment.yml'
        DEPLOYMENT_FILE3 = 'topps/order-gateway-beat/uat/deployment.yml'
    }

    stages {
        stage('Checkout App Code & Get Version') {
            steps {
                dir('app') {
                    checkout scmGit(
                        branches: [[name: '*/develop']],
                        userRemoteConfigs: [[
                            url: 'https://itdev25@bitbucket.org/qpp-team/order-gateway.git',
                            credentialsId: 'bitbucket-ci-api-token'
                        ]]
                    )

                script {
                    def appVersion = sh(
                        script: '''
                            grep '^version =' pyproject.toml \
                            | head -1 \
                            | awk -F'= ' '{ print $2 }' \
                            | sed 's/["]//g'
                        ''',
                        returnStdout: true
                    ).trim()
                
                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()
                
                    env.IMAGE_TAG = "${appVersion}-${commitId}-dev"
                
                    echo "Detected Version : ${appVersion}"
                    echo "Commit ID        : ${commitId}"
                    echo "Image Tag        : ${env.IMAGE_TAG}"
                }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container('docker') {
                    script {
                        sh """
                            docker build \
                              -t ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:${IMAGE_TAG} \
                              -t ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:latest \
                              -f app/Dockerfile \
                              app
                        """
                    }
                }
            }
        }

        stage('Push to ACR') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'aliyun-acr-credential',
                        usernameVariable: 'ACR_USER',
                        passwordVariable: 'ACR_PASS'
                    )]) {
                        sh """
                            echo "\${ACR_PASS}" | docker login \
                                --username="\${ACR_USER}" \
                                --password-stdin \
                                ${ACR_REGISTRY}

                            docker push ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:${IMAGE_TAG}
                            docker push ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:latest

                            docker logout ${ACR_REGISTRY}
                        """
                        echo "Successfully pushed image: ${ACR_REGISTRY}/${ACR_NAMESPACE}/${ACR_REPO}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Checkout Plugin DevOps Helm Chart Repo') {
            steps {
                script {
                    dir('gitops-ack') {
                        checkout scmGit(
                            branches: [[name: '*/main']],
                            extensions: [
                                localBranch('main')
                            ],
                            userRemoteConfigs: [[
                                url: 'https://itdev25@bitbucket.org/qpp-team/gitops-ack.git',
                                credentialsId: 'bitbucket-ci-api-token'
                            ]]
                        )
                    }
                }
            }
        }

        stage('Update Deployment Image Tag - topps/order-gateway/uat') {
            steps {
                dir('gitops-ack') {
                    sh """
                        echo "update DEPLOYMENT_FILE1"
                        if ! grep -q '${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:' ${env.DEPLOYMENT_FILE1}; then
                            echo "ERROR: Expected image pattern not found in ${env.DEPLOYMENT_FILE1}"
                            exit 1
                        fi

                        sed -i 's|\\(image:[[:space:]]*${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:\\)[^[:space:]]*|\\1${env.IMAGE_TAG}|g' ${env.DEPLOYMENT_FILE1}
                        
                        if ! grep -q '${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:${env.IMAGE_TAG}' ${env.DEPLOYMENT_FILE1}; then
                            echo "ERROR: Image tag replacement failed! Please check ${env.DEPLOYMENT_FILE1}"
                            exit 1
                        fi
                        
                        echo "update DEPLOYMENT_FILE2"
                        if ! grep -q '${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:' ${env.DEPLOYMENT_FILE2}; then
                            echo "ERROR: Expected image pattern not found in ${env.DEPLOYMENT_FILE2}"
                            exit 1
                        fi

                        sed -i 's|\\(image:[[:space:]]*${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:\\)[^[:space:]]*|\\1${env.IMAGE_TAG}|g' ${env.DEPLOYMENT_FILE2}
                        
                        if ! grep -q '${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:${env.IMAGE_TAG}' ${env.DEPLOYMENT_FILE2}; then
                            echo "ERROR: Image tag replacement failed! Please check ${env.DEPLOYMENT_FILE2}"
                            exit 1
                        fi                        

                        echo "update DEPLOYMENT_FILE3"
                        if ! grep -q '${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:' ${env.DEPLOYMENT_FILE3}; then
                            echo "ERROR: Expected image pattern not found in ${env.DEPLOYMENT_FILE3}"
                            exit 1
                        fi

                        sed -i 's|\\(image:[[:space:]]*${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:\\)[^[:space:]]*|\\1${env.IMAGE_TAG}|g' ${env.DEPLOYMENT_FILE3}
                        
                        if ! grep -q '${env.ACR_VPC_REGISTRY}/${env.ACR_NAMESPACE}/${env.ACR_REPO}:${env.IMAGE_TAG}' ${env.DEPLOYMENT_FILE3}; then
                            echo "ERROR: Image tag replacement failed! Please check ${env.DEPLOYMENT_FILE3}"
                            exit 1
                        fi
                        

                        echo "Verified: image tag updated successfully"
                        grep 'image:' ${env.DEPLOYMENT_FILE1}
                        grep 'image:' ${env.DEPLOYMENT_FILE2}
                        grep 'image:' ${env.DEPLOYMENT_FILE3}
                    """
                }
            }
        }
        

        stage('Commit and Push Changes - topps/order-gateway/uat') {
            steps {
                script {
                    dir('gitops-ack') {
                        withCredentials([usernamePassword(
                            credentialsId: 'bitbucket-cd-access-token-gitops-ack',
                            usernameVariable: 'GIT_USERNAME',
                            passwordVariable: 'GIT_PASSWORD'
                        )]) {
                            sh """
                                git config user.email "jenkins@qpp.com"
                                git config user.name "Jenkins CI"
                                
                                git add topps/order-gateway/uat/deployment.yml
                                git add topps/order-gateway-worker/uat/deployment.yml
                                git add topps/order-gateway-beat/uat/deployment.yml                                

                                if git diff --staged --quiet; then
                                    echo "No changes to commit"
                                else
                                    git commit -m "Update order-gateway deployment image tag to ${IMAGE_TAG}"

                                    git config credential.helper '!f() { echo "username=\$GIT_USERNAME"; echo "password=\$GIT_PASSWORD"; }; f'

                                    git push origin main

                                    git config --unset credential.helper

                                    echo "Successfully pushed changes to gitops-ack repository"
                                fi
                            """
                        }
                    }
                }
            }
        }
        stage('Cleanup Docker Images') {
            steps {
                container('docker') {
                    script {
                        sh """
                            docker rmi ${ACR_REGISTRY}/${ACR_REPO}:${IMAGE_TAG} || true
                            docker rmi ${ACR_REGISTRY}/${ACR_REPO}:latest || true                           
                        """
                    }
                }
            }
        }                
    


    }
    post {
        success {
            echo "Pipeline completed successfully!"
            echo "Docker Image Tag: ${env.IMAGE_TAG}"
            echo "Image pushed to: ${ACR_REGISTRY}/${ACR_REPO}:${env.IMAGE_TAG}"

        }
        failure {
            echo "Pipeline failed!"
            echo "Please check the logs for error details"
        }
        always {
            echo "Cleaning workspace"
            cleanWs()
        }
    }
}