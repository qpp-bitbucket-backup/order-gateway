# Database Configuration - MySQL (Split Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=order_user
DB_PASSWORD=order_password
DB_NAME=order_gateway

# Application Settings
APP_NAME="Order Gateway API"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Fallback origin only (no HTTP request context, e.g. scripts); the real link
# always uses the requesting host + PASSWORD_RESET_PATH
PASSWORD_RESET_URL=http://localhost:8000
PASSWORD_RESET_PATH=/admin/reset-password

# SendGrid Email Configuration (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@order-gateway.com
SENDGRID_FROM_NAME=Order Gateway
# Optional: SendGrid Dynamic Template ID for the reset email
# (https://app.sendgrid.com/dynamic_templates). Empty = local template
# rendered by app/services/email_templates.py.
# Template handlebars variables: {{{display_name}}} {{{reset_link}}} {{{expire_minutes}}}
SENDGRID_RESET_PASSWORD_TEMPLATE_ID=

# HP Site Flow OneFlow API Authentication
ONEFLOW_TOKEN=oneflow-token-change-in-production
ONEFLOW_SECRET=oneflow-secret-change-in-production

# Admin API key for /api/client management endpoints
ADMIN_API_KEY=admin-api-key-change-in-production

# Default Admin User (seeded on first startup)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@order-gateway.com
DEFAULT_ADMIN_PASSWORD=admin123

# HP PrintOS webhook credentials
HP_CLIENT_ID=hp-client-id-here
HP_CLIENT_SECRET=hp-client-secret-here

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Celery Configuration (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_BEAT_SYNC_ENABLED=true
CELERY_BEAT_SYNC_PRODUCT_INTERVAL_MINUTES=5

# QPMN API Configuration
QPMN_API_URL=https://api.qpmn.com/v1
QPMN_API_KEY=
QPMN_PUSH_RETRY_COUNT=5
QPMN_PUSH_RETRY_COUNTDOWN=900
QPMN_PUSH_RETRY_MAX_COUNTDOWN=7200
QPMN_PAYMENT_METHOD=PayPal

# OMS API Configuration
OMS_API_URL=https://api.oms.com/cgp-rest/api
OMS_VALIDATE_RETRY_COUNT=5
OMS_VALIDATE_RETRY_COUNTDOWN=300
OMS_VALIDATE_RETRY_MAX_COUNTDOWN=3600

# QPMN inbound webhook authentication: each store's Basic token is stored on
# its own `clients.store_key` row (see QPMN's per-store "店铺授权Token"), not
# a global setting here.

# OMS HUB4 transport configuration (Baozun standard)
OMS_APP_SECRET=
OMS_SOURCE_APP=
OMS_INTERFACE_TYPE=1
OMS_STATUS_METHOD_NAME=shipment_order_notify

# Alibaba Cloud OSS Configuration
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name
OSS_REGION=cn-hangzhou
OSS_UPLOAD_EXPIRY_SECONDS=3600
OSS_DOWNLOAD_EXPIRY_SECONDS=7200

# PDF Processing Configuration
MODIFY_PDF_RESOLUTION=false
PDF_TARGET_WIDTH=595.0
PDF_TARGET_HEIGHT=842.0
# Render split single-page design PDFs to PNG before QPMN upload
CONVERT_TO_PNG=false
PDF_TO_PNG_DPI=300

# Sentry Configuration
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=development

# SkyWalking Configuration
SKYWALKING_ENABLED=false
SKYWALKING_SERVICE_NAME=order-gateway
SKYWALKING_INSTANCE=localhost
SKYWALKING_BACKEND_ADDRESS=localhost:11800
